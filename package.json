{
  "name": "@vllnt/next-llms",
  "version": "0.1.1",
  "description": "Generate an llms.txt file and serve pages as Markdown from Next.js App Router route handlers, using Web-standard Request and Response and no dependencies.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "files": [
    "dist",
    "src",
    "docs/API.md",
    "CHANGELOG.md",
    "llms.txt",
    "!src/**/*.test.ts",
    "!src/**/*.spec.*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:ci": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-ci.tsbuildinfo --project tsconfig.ci.json",
    "lint": "pnpm check:agents && eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "test:package": "bash scripts/test-package.sh",
    "preversion": "pnpm install --frozen-lockfile && pnpm build && pnpm test:coverage && pnpm typecheck",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\""
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@vllnt/eslint-config": "2.1.0",
    "@vllnt/typescript": "3.0.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.1"
  },
  "homepage": "https://oss.vllnt.com/packages/next-llms",
  "bugs": {
    "url": "https://github.com/vllnt/next-llms/issues"
  },
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/next-llms"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "keywords": [
    "llms.txt",
    "llms-txt",
    "nextjs",
    "app-router",
    "route-handler",
    "markdown",
    "llm",
    "ai-agents",
    "typescript",
    "edge-runtime"
  ]
}
